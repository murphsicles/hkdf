/// ⚡ @crypto/hkdf — HMAC-based Extract-and-Expand Key Derivation (RFC 5869)
///
/// Thin re-export package wrapping @crypto/sha2's HMAC-SHA256 HKDF implementation.
/// Provides the standalone HKDF API matching the Rust `hkdf` crate.

use @crypto/sha2;

/// HKDF extract step: PRK = HMAC-SHA256(salt, IKM)
/// Returns a 32-byte pseudorandom key.
pub fn extract(salt: &[u8], ikm: &[u8]) -> [u8; 32] {
    return sha2::hmac_sha256(salt, ikm);
}

/// HKDF expand step: produces `len` bytes of key material from PRK.
pub fn expand(prk: &[u8], info: &[u8], len: i64) -> Vec<u8> {
    return sha2::hkdf_expand(prk, info, len);
}

/// Full HKDF: extract-then-expand in one call.
pub fn derive(salt: &[u8], ikm: &[u8], info: &[u8], len: i64) -> Vec<u8> {
    let prk = extract(salt, ikm);
    return expand(&prk, info, len);
}

/// Okm — output keying material wrapper
pub struct Okm {
    data: Vec<u8>,
}

impl Okm {
    pub fn new(data: Vec<u8>) -> Okm {
        return Okm { data: data };
    }

    pub fn as_bytes(&self) -> &[u8] {
        return &self.data;
    }

    pub fn len(&self) -> i64 {
        return self.data.len();
    }
}

/// Salt — optional HKDF salt (empty salt = zero-filled hash block)
pub fn default_salt() -> [u8; 32] {
    return [0u8; 32];
}

#[cfg(test)]
fn test_hkdf_rfc5869() -> bool {
    // RFC 5869 Test Case 1
    let ikm: [u8; 22] = [
        0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b,
        0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b,
        0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b,
    ];
    let salt: [u8; 13] = [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c];
    let info: [u8; 10] = [0xf0, 0xf1, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8, 0xf9];

    let okm = derive(&salt, &ikm, &info, 42);
    let expected: [u8; 42] = [
        0x3c, 0xb2, 0x5f, 0x25, 0xfa, 0xac, 0xd5, 0x7a,
        0x90, 0x43, 0x4f, 0x64, 0xd0, 0x36, 0x2f, 0x2a,
        0x2d, 0x2d, 0x0a, 0x90, 0xcf, 0x1a, 0x5a, 0x4c,
        0x5d, 0xb0, 0x2d, 0x56, 0xec, 0xc4, 0xc5, 0xbf,
        0x34, 0x00, 0x72, 0x08, 0xd5, 0xb8, 0x87, 0x18,
        0x58, 0x65,
    ];

    if okm.len() != 42 { return false; }
    let mut i: i64 = 0;
    while i < 42 {
        if okm.as_bytes()[i] != expected[i] { return false; }
        i = i + 1;
    }
    return true;
}
